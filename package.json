{
  "name": "local-ai-kit-workspace",
  "private": true,
  "version": "0.1.0-alpha.1",
  "type": "module",
  "workspaces": ["packages/sdk-typescript", "packages/selector-core"],
  "engines": {"node": ">=22.16"},
  "scripts": {
    "build": "tsc -p packages/selector-core/tsconfig.json && tsc -p packages/sdk-typescript/tsconfig.json",
    "test:unit": "python scripts/verify.py --profile javascript",
    "test:sdk": "python scripts/verify.py --profile sdk-typescript",
    "typecheck": "npm run build",
    "check:generated": "python scripts/check_generated.py"
  },
  "devDependencies": {"typescript": "5.8.3"}
}
