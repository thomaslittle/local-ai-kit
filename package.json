{
  "name": "local-ai-kit-workspace",
  "private": true,
  "version": "0.1.0-alpha.1",
  "type": "module",
  "workspaces": [
    "packages/sdk-typescript",
    "packages/selector-core",
    "packages/react",
    "packages/ui-react"
  ],
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "build": "tsc -p packages/selector-core/tsconfig.json && tsc -p packages/sdk-typescript/tsconfig.json && tsc -p packages/react/tsconfig.json && tsc -p packages/ui-react/tsconfig.json",
    "test:unit": "python scripts/verify.py --profile javascript",
    "test:sdk": "python scripts/verify.py --profile sdk-typescript",
    "typecheck": "npm run build",
    "check:generated": "python scripts/check_generated.py",
    "test:react": "npm run build && node --test packages/react/tests/*.test.mjs packages/ui-react/tests/*.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "5.8.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "26.1.0",
    "esbuild": "0.25.12"
  }
}
