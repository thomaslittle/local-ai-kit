{
  "name": "local-ai-kit-workspace",
  "private": true,
  "version": "0.1.0-alpha.8",
  "type": "module",
  "workspaces": [
    "packages/sdk-typescript",
    "packages/selector-core",
    "packages/react",
    "packages/ui-react"
  ],
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "build": "tsc -p packages/selector-core/tsconfig.json && tsc -p packages/sdk-typescript/tsconfig.json && tsc -p packages/react/tsconfig.json && tsc -p packages/ui-react/tsconfig.json && tsc -p apps/demo/tsconfig.json",
    "test:unit": "python scripts/verify.py --profile javascript",
    "test:sdk": "python scripts/verify.py --profile sdk-typescript",
    "typecheck": "npm run build",
    "check:generated": "python scripts/check_generated.py",
    "test:react": "npm run build && node --test packages/react/tests/*.test.mjs packages/ui-react/tests/*.test.mjs",
    "test": "python scripts/verify.py --profile all",
    "test:ui": "python scripts/verify.py --profile ui",
    "test:a11y": "npm run build && node --test scripts/test_accessibility.mjs scripts/test_component_accessibility.mjs",
    "build:demo": "npm run build && node scripts/build_demo.mjs",
    "demo": "npm run build:demo && node scripts/run_live_demo.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "lucide-react": "^0.454.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.8.3",
    "vite": "^7.3.6",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
